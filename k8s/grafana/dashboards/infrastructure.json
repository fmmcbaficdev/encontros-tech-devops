{
  "title": "Encontros Tech — Infrastructure",
  "uid": "et-infra",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "CPU Usage por Pod",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [{ "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"production\"}[5m]))", "legendFormat": "{{pod}}" }]
    },
    {
      "id": 2, "type": "timeseries", "title": "Memory Usage por Pod (MB)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [{ "expr": "sum by (pod) (container_memory_usage_bytes{namespace=\"production\"}) / 1024 / 1024", "legendFormat": "{{pod}}" }]
    },
    {
      "id": 3, "type": "timeseries", "title": "Network I/O (bytes/s)",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum(rate(container_network_receive_bytes_total{namespace=\"production\"}[5m]))", "legendFormat": "receive" },
        { "expr": "sum(rate(container_network_transmit_bytes_total{namespace=\"production\"}[5m]))", "legendFormat": "transmit" }
      ]
    },
    {
      "id": 4, "type": "gauge", "title": "HPA — Replicas Atuais",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [{ "expr": "kube_horizontalpodautoscaler_status_current_replicas{namespace=\"production\"}", "legendFormat": "replicas" }]
    }
  ]
}
